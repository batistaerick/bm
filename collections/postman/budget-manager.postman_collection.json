        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const setCookieHeaders = pm.response.headers",
                  "    .all()",
                  "    .filter((header) => header.key.toLowerCase() === \"set-cookie\")",
                  "    .map((header) => header.value);",
                  "",
                  "function saveCookieValue(cookieName) {",
                  "    const cookieHeader = setCookieHeaders.find((header) =>",
                  "        header.startsWith(`${cookieName}=`)",
                  "    );",
                  "",
                  "    if (!cookieHeader) {",
                  "        console.warn(`${cookieName} cookie not found`);",
                  "        return;",
                  "    }",
                  "",
                  "    const value = cookieHeader.split(\";\")[0].split(\"=\").slice(1).join(\"=\");",
                  "",
                  "    pm.environment.set(cookieName, value);",
                  "    pm.collectionVariables.set(cookieName, value);",
                  "    console.log(`${cookieName} saved`);",
                  "}",
                  "",
                  "saveCookieValue(\"access_token\");",
                  "saveCookieValue(\"refresh_token\");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
