  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "const method = pm.request.method;",
          "const path = `/${pm.request.url.getPath().replace(/^\\//, \"\")}`;",
          "const isUnsafeMethod = ![\"GET\", \"HEAD\", \"OPTIONS\"].includes(method);",
          "const isCsrfIgnored =",
          "    path === \"/auth/login\" ||",
          "    path === \"/auth/refresh\" ||",
          "    path === \"/auth/logout\" ||",
          "    path === \"/auth/csrf\" ||",
          "    (method === \"POST\" && path === \"/users\");",
          "",
          "if (isUnsafeMethod && !isCsrfIgnored) {",
          "    pm.sendRequest(",
          "        {",
          "            url: `${pm.variables.get(\"baseURL\").replace(/\\/$/, \"\")}/auth/csrf`,",
          "            method: \"GET\"",
          "        },",
          "        (error, response) => {",
          "            if (error) {",
          "                console.error(\"Unable to refresh CSRF token\", error);",
          "                return;",
          "            }",
          "",
          "            const body = response.json();",
          "",
          "            if (body.token) {",
          "                pm.environment.set(\"csrf_token\", body.token);",
          "                pm.collectionVariables.set(\"csrf_token\", body.token);",
          "                pm.request.headers.upsert({ key: \"X-CSRF-Token\", value: body.token });",
          "                console.log(\"csrf_token refreshed\");",
          "            } else {",
          "                console.warn(\"csrf_token not found in /auth/csrf response\");",
          "            }",
          "        }",
          "    );",
          "}",
          ""
        ],
        "type": "text/javascript",
        "packages": {},
        "requests": {}
      }
    }
  ],
